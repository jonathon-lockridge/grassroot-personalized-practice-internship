# Copy this file to .env and fill in real values. Never upload .env; git ignores it.

# Secret key the Grassroot platform sends with every request (used from step T5).
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=replace-with-a-long-random-string

# Where learner data is stored (used from step T3). A SQLite file locally; a Postgres address in production.
DATABASE_URL=sqlite:///./practice_engine.db
