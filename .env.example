# Copy to .env and fill in real values. Never commit .env.

# Shared secret the Grassroot platform sends as the X-API-Key header (used from ticket T5).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=replace-with-a-long-random-string

# Where learner state lives (used from ticket T3). SQLite locally; a Postgres URL in production.
DATABASE_URL=sqlite:///./practice_engine.db

# LLM problem-variant generation (used from ticket T7). Keep disabled until T7 is reviewed.
AI_SERVICE_API_KEY=your-ai-service-key-here
GENERATION_ENABLED=false
